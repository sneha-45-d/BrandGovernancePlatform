# ==============================================================================
# BRANDITHM API - Production Environment Configuration Template
# ==============================================================================

# Application Port (Set automatically by Render, Railway, Heroku, etc.)
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# Option 1: MongoDB Atlas (Recommended for cloud PaaS deployments like Render / Railway)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/brandithm?retryWrites=true&w=majority
DB_NAME=brandithm

# Option 2: SQLite Local Persistence
# When deploying to Docker or VPS, ensure this directory is mounted to a persistent volume:
LOCAL_DB_PATH=/app/data/brandithm.sqlite3

# ------------------------------------------------------------------------------
# Security & Session Authentication
# ------------------------------------------------------------------------------
# Generate a secure 64-character random key (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key-32-chars

# ------------------------------------------------------------------------------
# Google Gemini AI Integration
# ------------------------------------------------------------------------------
# Obtain your free or pay-as-you-go key from Google AI Studio (https://aistudio.google.com/)
GOOGLE_API_KEY=AIzaSy...your-actual-api-key...
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated origins of your deployed frontend application(s)
# Example: https://brandithm.vercel.app,https://app.brandithm.com
ALLOWED_ORIGINS=https://brandithm.vercel.app,https://yourdomain.com

