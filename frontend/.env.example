# Backend API Base URL for Production Deployment (Vercel, Netlify, CloudFront, etc.)
# If frontend is hosted separately from backend, set this to your deployed FastAPI backend URL:
# Example: VITE_API_BASE_URL=https://brandithm-backend.onrender.com
# For local dev or all-in-one Docker/Nginx deployment, leave empty.
VITE_API_BASE_URL=
